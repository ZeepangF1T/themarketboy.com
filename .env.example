# Copy this to .env and set secure values for production
POSTGRES_DB=themarketboy
POSTGRES_USER=tm_user
POSTGRES_PASSWORD=tm_pass
DATABASE_URL=postgres://tm_user:tm_pass@db:5432/themarketboy

# App settings
JWT_SECRET=change_this_secret_in_prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_admin_password
APP_DOMAIN=www.themarketboy.com
APP_ORIGIN=https://www.themarketboy.com
LETSENCRYPT_EMAIL=you@example.com

# pgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=admin
